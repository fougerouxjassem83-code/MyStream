<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abonnement - MyStream</title>

    <!-- ICI j'appelle le fichier de ma navbar.css -->
    <link rel="stylesheet" href="/css/navbar.css">

    <!-- ICI j'appelle mon fichier CSS de l'abonnement -->
    <link rel="stylesheet" href="/css/abonnement.css">
</head>
<body>

    <!-- ICI j'appelle ma navbar -->
    <%- include('navbar') %>

    <!-- Titre de la page -->
    <h1>Nos Abonnements</h1>

    <!-- ICI j'affiche les offres d'abonnement -->
    <div class="abonnements">
        <% abonnements.forEach(function(abonnement) { %>
        <div class="carte-abonnement">

            <!-- Titre de l'abonnement -->
            <h2><%= abonnement.titre %></h2>

            <!-- Qualité vidéo de l'abonnement -->
            <p class="qualite"><%= abonnement.qualite %></p>

            <!-- Le prix -->
            <p class="prix"><%= abonnement.prix %> €/mois</p>

            <!-- Liste des avantages selon l'abonnement -->
            <ul class="avantages">
                <!-- Avantages communs à tous -->
                <li>Pas de pubs</li>
                <li>Accès à la bibliothèque MyStream</li>

                <% if (abonnement.titre === 'Basic') { %>
                    <!-- Avantages Basic -->
                    <li><span class="highlight">1 appareil</span> en même temps</li>

                <% } else if (abonnement.titre === 'Standard') { %>
                    <!-- Avantages Standard -->
                    <li><span class="highlight">2 appareils</span> en même temps</li>
                    <li>Mode hors-ligne</li>

                <% } else if (abonnement.titre === 'Premium') { %>
                    <!-- Avantages Premium -->
                    <li><span class="highlight">4 appareils</span> en même temps</li>
                    <li>Mode hors-ligne</li>
                    <li>Qualité 4K</li>

                <% } %>
            </ul>

            <!-- Je crée un formulaire pour souscrire à l'abonnement -->
            <form action="/souscrire" method="POST">

                <!-- J'envoie l'id de l'abonnement choisi -->
                <input type="hidden" name="id_abonnement" value="<%= abonnement.id_abonnement %>">

                <!-- Bouton pour choisir l'abonnement -->
                <button type="submit" class="btn-souscrire">Choisir</button>

            </form>

        </div>
        <% }) %>
    </div>

</body>
</html>